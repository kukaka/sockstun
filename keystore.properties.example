# 复制为 keystore.properties 并填入你的签名信息。
# keystore.properties 已在 .gitignore 中，不要提交。
#
# 生成密钥：
#   keytool -genkeypair -v -keystore release.jks -alias sockstun \
#           -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# 或直接运行 ./scripts/make-release.sh

storeFile=release.jks
keyAlias=sockstun
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
